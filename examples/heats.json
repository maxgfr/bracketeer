{
  "$schema": "https://github.com/maxgfr/bracketeer",
  "name": "Heats of four",
  "summary": "Four compete in every match and score by where they finish, not by who they beat. Heats are drawn between entrants of similar standing, so nobody spends the evening last.",
  "signature": "four per match · finishing order · points by place",
  "config": {
    "match": {
      "sidesPerMatch": 4
    },
    "score": {
      "kind": "placement",
      "pointsByPlace": [
        15,
        12,
        10,
        8
      ]
    },
    "pairing": {
      "strategy": "closest_rating"
    },
    "standings": {
      "pointsSource": "score",
      "tiebreakers": [
        {
          "key": "points"
        },
        {
          "key": "wins"
        },
        {
          "key": "drawn_lot"
        }
      ]
    },
    "rating": {
      "system": "trueskill"
    },
    "stages": [
      {
        "kind": "swiss",
        "id": "heats",
        "name": "Heats",
        "rounds": 6
      }
    ]
  }
}
