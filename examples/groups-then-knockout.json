{
  "$schema": "https://github.com/maxgfr/bracketeer",
  "name": "Groups, then a knockout",
  "summary": "The field is split into groups that play everyone-plays-everyone, and the top two from each go through to a knockout. Three matches guaranteed before anything is at stake.",
  "signature": "groups → knockout · top two advance",
  "config": {
    "score": {
      "kind": "points",
      "allowDraw": true
    },
    "standings": {
      "pointsSystem": {
        "win": 3,
        "draw": 1,
        "loss": 0
      },
      "tiebreakers": [
        {
          "key": "points"
        },
        {
          "key": "point_diff"
        },
        {
          "key": "points_for"
        },
        {
          "key": "drawn_lot"
        }
      ]
    },
    "rating": {
      "system": "none"
    },
    "stages": [
      {
        "kind": "groups",
        "id": "groups",
        "name": "Groups",
        "groupSize": 4,
        "inner": {
          "kind": "round_robin"
        },
        "qualification": {
          "perGroup": 2
        }
      },
      {
        "kind": "single_elimination",
        "id": "final-stage",
        "name": "Knockout",
        "consolation": "third_place"
      }
    ],
    "entrantFields": [
      {
        "key": "affiliation",
        "label": "Club or team",
        "private": false
      }
    ]
  }
}
