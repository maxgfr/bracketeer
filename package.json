{
  "name": "bracketeer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, configurable, sport-agnostic tournament engine that runs entirely in your browser",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@9": "^10.2.5"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @bracketeer/web dev",
    "build": "pnpm --filter @bracketeer/web build",
    "preview": "pnpm --filter @bracketeer/web preview",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @bracketeer/engine test:watch",
    "typecheck": "pnpm -r typecheck",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8"
  }
}
