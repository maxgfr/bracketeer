{
  "name": "@bracketeer/presets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starting points: shapes named for the question they answer, and sports as points in the same configuration space",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bracketeer/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
