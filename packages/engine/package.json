{
  "name": "@bracketeer/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sport-agnostic tournament engine: formats, pairing, standings, ratings and scheduling as composable primitives",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
