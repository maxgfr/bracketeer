{
  "name": "bracketeer-cli",
  "version": "0.3.1",
  "type": "module",
  "description": "Sport-agnostic tournament engine — a library, a CLI, and an MCP server: formats, pairing, standings, ratings, and share links that carry only what the audience should see",
  "license": "MIT",
  "keywords": [
    "tournament",
    "bracket",
    "swiss",
    "round-robin",
    "elo",
    "glicko",
    "pairing",
    "standings",
    "cli",
    "mcp"
  ],
  "bin": {
    "bracketeer": "./dist/cli.mjs",
    "bracketeer-cli": "./dist/cli.mjs",
    "bracketeer-mcp": "./dist/mcp.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @bracketeer/engine --filter @bracketeer/presets build:types && tsup",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bracketeer/engine": "workspace:*",
    "@bracketeer/presets": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "fflate": "^0.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgfr/bracketeer.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/maxgfr/bracketeer/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/maxgfr/bracketeer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
